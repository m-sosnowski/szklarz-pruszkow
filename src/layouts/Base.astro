---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Drawer from '../components/layout/Drawer.astro';
import Footer from '../components/layout/Footer.astro';
import CallBar from '../components/layout/CallBar.astro';
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { breadcrumbSchema, localBusinessSchema, webSiteSchema, type Crumb } from '../lib/schema';
import type { ResolvedSeo } from '../lib/seo';

interface Props {
  seo: ResolvedSeo;
  ogType?: 'website' | 'article' | 'product';
  crumbs?: Crumb[];
  /** Dodatkowe grafy JSON-LD specyficzne dla strony (Service, FAQPage…). */
  schemas?: (Record<string, unknown> | undefined)[];
}

const { seo, ogType = 'website', crumbs = [], schemas = [] } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1f26" />

    <script is:inline>
      // Animacje pojawiania się mają sens tylko wtedy, gdy jest kto je odpali.
      // Bez tej klasy `.reveal` zostaje po prostu widoczne — patrz global.css.
      document.documentElement.classList.add('js');
    </script>

    <Meta seo={seo} ogType={ogType} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Font nagłówkowy jest widoczny w pierwszym ekranie — bez preloadu
         H1 przez chwilę renderuje się fontem systemowym i skacze. -->
    <link
      rel="preload"
      href="/fonts/sora-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <JsonLd schema={localBusinessSchema()} />
    <JsonLd schema={webSiteSchema()} />
    <JsonLd schema={breadcrumbSchema(crumbs)} />
    {schemas.map((schema) => <JsonLd schema={schema} />)}

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>

    <Header />
    <Drawer />

    <main id="tresc">
      <slot />
    </main>

    <Footer />
    <CallBar />

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
