---
import Section from './Section.astro';

interface Props {
  eyebrow?: string | undefined;
  heading?: string | undefined;
  intro?: string | undefined;
  items: { title: string; body: string }[];
  background?: 'paper' | 'mist' | 'deep' | 'glass';
  tight?: boolean;
  anchor?: string | undefined;
}

const { eyebrow, heading, intro, items, ...section } = Astro.props;
---

<Section eyebrow={eyebrow} heading={heading} intro={intro} {...section}>
  <ol class="steps reveal">
    {
      items.map((item, index) => (
        <li class="step">
          <b>Krok {String(index + 1).padStart(2, '0')}</b>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .steps li {
    margin: 0;
  }
</style>
